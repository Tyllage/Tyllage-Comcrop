# Only needed when the client is deployed separately from the API.
# Leave empty when Express serves the built client (single Railway service) — the client then calls /api on the same origin.
VITE_API_URL=

# Show the demo-account picker on the login page in production builds (always shown in dev).
VITE_SHOW_DEMO_ACCOUNTS=false

# WhatsApp number for the website's floating chat button, in international format (e.g. 6591234567).
# Leave empty to hide the button. Read at build time, so rebuild after changing it.
VITE_WHATSAPP_NUMBER=
